{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Participant nickname",
      "minLength": 1,
      "maxLength": 240
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "title": "Age in years"
    },
    "goal": {
      "type": "string",
      "enum": [
        "Move more",
        "Sleep better",
        "Stay hydrated"
      ],
      "title": "Wellbeing goal"
    },
    "description": {
      "type": "string",
      "title": "Short description",
      "maxLength": 120
    }
  },
  "required": [
    "name",
    "age",
    "goal"
  ]
}
