{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "feeling": {
      "type": "string",
      "enum": [
        "Good",
        "Okay",
        "Not great"
      ],
      "title": "How are you feeling?"
    },
    "sleep": {
      "type": "integer",
      "minimum": 0,
      "maximum": 24,
      "title": "Hours of sleep last night"
    },
    "notes": {
      "type": "string",
      "title": "Check-in notes",
      "minLength": 1,
      "maxLength": 240
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "entity_id",
    "feeling",
    "sleep",
    "notes"
  ]
}
